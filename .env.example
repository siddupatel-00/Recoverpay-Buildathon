# RecoverPay env — copy to .env.local, NEVER commit secrets
# --- AI ---
GEMINI_API_KEY=AIza_YOUR_KEY_HERE
# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=
# --- Cron (optional guard) ---
CRON_SECRET=recoverpay-cron-secret
# --- Admin (SEC-02: bearer auth for cron/resolve/export in production) ---
ADMIN_BEARER_TOKEN=change_this_in_production
# Demo dashboard needs the same token client-side to call admin routes.
# For real production, rotate this and put admin calls behind your own auth.
NEXT_PUBLIC_ADMIN_BEARER_TOKEN=change_this_in_production
# --- Demo switches ---
ALLOW_DEMO_SIMULATE=true
# --- DB: leave empty for local file; set for deploy ---
TURSO_URL=
TURSO_AUTH_TOKEN=
# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
WHATSAPP_VERIFY_TOKEN=recoverpay-test
